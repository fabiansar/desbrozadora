[node name="Bosque" parent="." unique_id=1093573865 instance=ExtResource("4_bosque")]

; Las tres plantas son la MISMA escena con numeros distintos. Los presets viven en
; scenes/vegetacion/ y cada uno lleva dentro sus numeros, asi que aqui solo se
; instancia. Para cambiar como es una planta se abre su preset, no esta escena.
[node name="Cesped" parent="." instance=ExtResource("5_cesped")]

[node name="MalezaAlta" parent="." instance=ExtResource("6_maleza")]

; La zarza es el tier 3: la misma hoja, oscura, ancha y tiesa, con un
; `radio` corto porque es una mancha local y no un campo. NO hay codigo de zarza
; en ninguna parte: antes eran 888 lineas con celdas, coronas y raices, y ahora
; es esta linea.
;
; **Un nodo por planta, exactamente igual que `Cesped` y `MalezaAlta`: la
; diferencia esta en el preset (numeros y aspecto), no en la escena ni en la
; estructura.** Antes habia cinco instancias de la zarza bajo un nodo contenedor
; `Zarzas` que no hacia nada; se redujo a esta una y se aplanó el contenedor el
; 2026-09-30, porque lo unico que aportaba era una excepcion en la jerarquia. El
; codigo no depende de la estructura: todo se localiza por el grupo `vegetacion`.
;
; Si algun dia hace falta zarza en varios sitios, no es un problema de escena:
; `radio` y `semilla` son `@export`, y colocar manchas es una decision de mapa
; (fase del valle), no de esta escena.
[node name="Zarza" parent="." instance=ExtResource("9_zarza")]
position = Vector3(0, 0, -7.0)

