[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/jugador.gd" id="1_jugador"]
[ext_resource type="Script" path="res://scripts/camara_gopro.gd" id="2_camara"]
[ext_resource type="PackedScene" path="res://models/personaje_trabajo.glb" id="4_personaje"]
[ext_resource type="Script" path="res://scripts/brazos_primera_persona.gd" id="5_brazos"]
[ext_resource type="Script" path="res://scripts/inventario.gd" id="6_inventario"]
[ext_resource type="Script" path="res://scripts/rueda_inventario.gd" id="7_rueda"]
[ext_resource type="Resource" path="res://resources/herramientas/desbrozadora.tres" id="8_desbrozadora"]
[ext_resource type="Resource" path="res://resources/herramientas/hoz.tres" id="9_hoz"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_cuerpo"]
radius = 0.35
height = 1.7

; Suelo, camara y luces van en "main.tscn", no aqui. El suelo tiene que estar
; quieto en el mundo: si cuelga del jugador se va con el y el jugador cae
; eternamente sin llegar nunca al suelo (y aun asi da "is_on_floor" true,
; porque esta encima de su propio suelo).

; La mascara lleva el 1 del suelo y el 4 de los arboles. Con solo el 1 se
; atravesaban los troncos como si fueran humo.
[node name="Player" type="CharacterBody3D"]
collision_layer = 2
collision_mask = 5
script = ExtResource("1_jugador")
cabeza = NodePath("Cabeza")

[node name="Colision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.85, 0)
shape = SubResource("CapsuleShape3D_cuerpo")

[node name="Cabeza" type="Node3D" parent="."]
; La GoPro va en la parte frontal de la cabeza, no dentro del pecho. La lente
; queda delante de la chaqueta para que torso y piernas entren en el encuadre.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.62, -0.30)

[node name="Camara" type="Camera3D" parent="Cabeza"]
fov = 100.0
script = ExtResource("2_camara")
jugador = NodePath("../..")

; Las caderas. La maquina va colgada de aqui y no de la camara, porque los
; brazos no nacen en los ojos: nacen en la cadera. Este nodo gira con retardo
; detras de la mirada, y ese retraso es lo que hace que al girar de golpe la
; maquina se mueva primero y las caderas vayan despues.
[node name="Caderas" type="Node3D" parent="."]

[node name="Cuerpo" type="Node3D" parent="."]

[node name="Modelo" parent="Cuerpo" instance=ExtResource("4_personaje")]
position = Vector3(0, 0, -0.10)

[node name="Brazos" type="Node3D" parent="."]
script = ExtResource("5_brazos")

; El punto donde se sujetan las manos. OJO: la posicion y la inclinacion las
; pone desbrozadora.gd cada fotograma en funcion de hacia donde se mira, asi
; que aqui solo esta el origen.
[node name="PivoteDesbrozadora" type="Node3D" parent="Caderas"]

; Las nueve cosas que llevas y la que tienes en la mano. La desbrozadora ya no
; esta aqui como nodo fijo: la crea el inventario al equipar el hueco 1, y por
; eso esta en el catalogo y no en la escena. La ESCENA de la herramienta sigue
; siendo scenes/desbrozadora.tscn, solo que ahora la pone el inventario.
[node name="Inventario" type="Node3D" parent="."]
script = ExtResource("6_inventario")
catalogo = Array[ExtResource("8_desbrozadora")]([ExtResource("8_desbrozadora"), ExtResource("9_hoz")])
ocupacion_inicial = Array[StringName]([&"desbrozadora", &"hoz"])
pivote = NodePath("../Caderas/PivoteDesbrozadora")

; La rueda de los nueve huecos, arriba a la derecha. Va suelta en el jugador y
; no como hija de la herramienta a proposito: la rueda tiene que verse tambien
; con las manos vacias, que es justo cuando mas hace falta saber que llevas.
[node name="RuedaInventario" type="CanvasLayer" parent="."]
script = ExtResource("7_rueda")
