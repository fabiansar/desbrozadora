[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/desbrozadora.gd" id="1_desbrozadora"]
[ext_resource type="PackedScene" path="res://models/desbrozadora.glb" id="2_modelo"]
[ext_resource type="AudioStream" path="res://audio/motor.wav" id="3_motor"]
[ext_resource type="Script" path="res://scripts/interfaz_herramienta.gd" id="4_interfaz"]
[ext_resource type="AudioStream" path="res://audio/corte.wav" id="5_corte"]

[node name="Desbrozadora" type="Node3D"]
script = ExtResource("1_desbrozadora")
modelo = NodePath("Modelo")
giro = NodePath("Modelo/Desbrozadora/Giro")
corte = NodePath("Modelo/Desbrozadora/Giro/Corte")
motor_sonido = NodePath("Motor")

; El modelo viene con el eje de la herramienta en +Z (tubo y cabezal hacia +Z),
; y una camara de Godot mira hacia -Z. Por eso el giro de 180 grados en Y: sin
; el, la desbrozadora se veria apuntando hacia atras. El giro en Y no cambia
; la altura, asi que el cabezal sigue quedandose por debajo de las manos.
[node name="Modelo" parent="." instance=ExtResource("2_modelo")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)

[node name="SonidoCorte" type="AudioStreamPlayer3D" parent="."]
stream = ExtResource("5_corte")
unit_size = 4.0
max_distance = 25.0

[node name="Motor" type="AudioStreamPlayer3D" parent="."]
stream = ExtResource("3_motor")
unit_size = 6.0
max_distance = 60.0

; Marcadores sobre el manillar (en el espacio final de la herramienta, despues
; del giro de 180 grados del modelo). Son el centro de los puños de goma y los
; brazos del personaje terminan aqui.
[node name="AgarreIzquierdo" type="Marker3D" parent="."]
position = Vector3(-0.2, 0.239, -0.039)

[node name="AgarreDerecho" type="Marker3D" parent="."]
position = Vector3(0.2, 0.239, -0.039)

[node name="Interfaz" type="CanvasLayer" parent="."]
script = ExtResource("4_interfaz")
