# La carpeta que Godot se guarda a si mismo: la regenera sola al abrir el
# proyecto y son 5 MB de cachés y importaciones. No tiene sentido vigilarla.
.godot/

# Igual que en el exportador: binarios ya montados. El codigo fuente, si.
export_presets.cfg
/build/
/export/
*.pck
*.zip

# Las herramientas de Blender estan en Python y Python guarda sus .pyc al
# ejecutarlas. Son binarios que se regeneran solos, como los de Godot.
__pycache__/
*.pyc

# Las piezas que aun no se usan en el juego: los cabezales de disco y de
# hilo, y la furgoneta. estan en el proyecto para tenerlas a mano cuando
# toque la fase de los discos o la conduccion, pero Godot no deberia
# importarlas ni el repositorio guardarlas mientras no entren en escena.
# Cuando una se use, se quita de aqui con git rm --cached.
models/cabezal_disco_2p.glb
models/cabezal_disco_2p.glb.import
models/cabezal_disco_3p.glb
models/cabezal_disco_3p.glb.import
models/cabezal_hilo.glb
models/cabezal_hilo.glb.import
models/furgoneta.glb
models/furgoneta.glb.import
