# La carpeta que Godot se guarda a si mismo: la regenera sola al abrir el
# proyecto y son 5 MB de cachés y importaciones. No tiene sentido vigilarla.
.godot/

# Igual que en el exportador: binarios ya montados. El codigo fuente, si.
export_presets.cfg
/build/
/export/
*.pck
*.zip

# Las herramientas de Blender estan en Python y Python guarda sus .pyc al
# ejecutarlas. Son binarios que se regeneran solos, como los de Godot.
__pycache__/
*.pyc
